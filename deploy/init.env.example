# Location outside the Git checkout. Export before running the operator.
MISE_EN_DICE_DEPLOY_ROOT=/opt/mise-en-dice/runtime

# Used only to print a ready-to-copy SSH tunnel command after deployments.
MISE_EN_DICE_SSH_USER=gridwords
MISE_EN_DICE_SSH_HOST=server.example.de

# Host ports always bind to 127.0.0.1. PostgreSQL never receives a host port.
MISE_EN_DICE_PRODUCTION_PORT=18080
MISE_EN_DICE_ACCEPTANCE_PORT=18090
MISE_EN_DICE_PREVIEW_PORT_START=18100
MISE_EN_DICE_PREVIEW_PORT_END=18199

# Validated local backups older than this are removed after a successful new backup.
MISE_EN_DICE_BACKUP_RETENTION_DAYS=14
MISE_EN_DICE_HEALTH_TIMEOUT_SECONDS=180
MISE_EN_DICE_APP_MEMORY_LIMIT=768m
MISE_EN_DICE_POSTGRES_MEMORY_LIMIT=512m

# For non-interactive CI/bootstrap only. Never commit real values.
# MISE_EN_DICE_ADMIN_ACTOR_KEY=
# MISE_EN_DICE_ADMIN_DISPLAY_NAME=
# MISE_EN_DICE_ADMIN_PASSWORD_HASH=
