# The application defaults to these values when variables are omitted.
MISE_EN_DICE_DB_NAME=mise_en_dice
MISE_EN_DICE_DB_USERNAME=mise_en_dice
MISE_EN_DICE_DB_PASSWORD=change-me-for-any-shared-environment
MISE_EN_DICE_DB_PORT=5432
MISE_EN_DICE_DB_HOST=localhost

# Keep the administration adapter disabled unless its external account configuration is complete.
MISE_EN_DICE_ADMINISTRATION_ENABLED=false
# Configure one or two accounts only when the adapter is enabled. Leave password hashes out of
# version control and use a distinct local value for each environment.
# MISE_EN_DICE_ADMINISTRATION_ACCOUNTS_0_ACTOR_KEY=
# MISE_EN_DICE_ADMINISTRATION_ACCOUNTS_0_DISPLAY_NAME=
# MISE_EN_DICE_ADMINISTRATION_ACCOUNTS_0_PASSWORD_HASH=

# Use these values when the application does not run on the host machine.
# MISE_EN_DICE_DB_URL=jdbc:postgresql://localhost:5432/mise_en_dice
